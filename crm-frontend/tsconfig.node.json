{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * e2e/ and playwright.config.ts are here so `npx tsc -b` — the check the
   * `frontend` CI job runs — actually type-checks them. Playwright transpiles
   * specs with esbuild, which strips types without checking them, so without
   * this the E2E suite is the one deliverable in the repo with no static gate at
   * all. It is not hypothetical: a `reducedMotion` key in the wrong place shipped
   * exactly because nothing type-checked this file.
   */
  "include": ["vite.config.ts", "playwright.config.ts", "e2e"]
}
